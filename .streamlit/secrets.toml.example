# Copy these into Streamlit Cloud → App settings → Secrets
# (TOML format). Do NOT commit a real secrets.toml with passwords.

USE_MOCK_DATA = "false"
LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "sk-ant-..."

# Hosted Postgres (Neon / Supabase) — NOT localhost
DATABASE_URL = "postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET = "replace-with-a-long-random-string"
JWT_ALGORITHM = "HS256"
AUTH_SESSION_HOURS = "24"
AUTH_ALLOWED_EMAIL_DOMAINS = "coherentmarketinsights.com"
AUTH_APP_NAME = "Vendor Intelligence"
AUTH_ADMIN_EMAILS = "you@coherentmarketinsights.com"

# On Cloud: use resend or smtp (console OTP is only in server logs)
AUTH_EMAIL_BACKEND = "console"
# AUTH_EMAIL_BACKEND = "resend"
# RESEND_API_KEY = "re_..."
# SMTP_FROM = "noreply@coherentmarketinsights.com"

# Pipeline defaults (site scrape on)
WEB_FETCH_ENABLED = "true"
MARKET_QUERY_OUTPUT_DIR = "output/demo"
PIPELINE_DIRECTORY_MINING = "true"
