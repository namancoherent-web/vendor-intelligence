# =============================================================================
# Vendor Intelligence — LOCAL laptop setup (no GCP / no Cloud Run)
# Copy this file to .env  →  copy .env.local.example .env
# Then paste ONE LLM API key below.
# =============================================================================

USE_MOCK_DATA=false
PIPELINE_PROFILE=quality

# --- Pick ONE LLM provider (required for real runs) ---
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=PASTE_YOUR_KEY_HERE
DEEPSEEK_MODEL=deepseek-chat

# Free / cheap alternative (comment DeepSeek above, uncomment these):
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=PASTE_YOUR_KEY_HERE
# OPENCODE_MODEL=nemotron-3-super-free

# Or Anthropic:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE

# --- Auth (email-only login; no OTP email needed) ---
AUTH_SKIP_OTP=true
AUTH_EMAIL_BACKEND=console
AUTH_APP_NAME=Vendor Intelligence
AUTH_ALLOWED_EMAIL_DOMAINS=coherentmarketinsights.com
JWT_SECRET=local-dev-only-change-me
AUTH_SESSION_HOURS=24

# SQLite auth DB — no Postgres / Docker required
DATABASE_URL=sqlite:///./data/vendor_intel_auth.db

# --- Search / scrape (free; no cloud) ---
# Cloud storage (GCS):
#   DEFAULT for team laptops = leave GCS_BUCKET commented / unset.
#   Then "Cloud files" stays local (output/ on this PC). No GCP needed.
#   Only set the next line if you intentionally want to read the SHARED
#   production bucket (needs Google Cloud login on this PC):
# GCS_BUCKET=vendor-intel-runs-488586803367
SEARCH_PRIMARY=duckduckgo
SEARCH_BACKUP=searxng
SEARXNG_BASE_URL=http://127.0.0.1:8080
SKIP_DDGS=false
SKIP_BING_HTML=false
# Bing first: some networks (corporate firewalls, certain ISPs) block/timeout DuckDuckGo,
# Google, and Mojeek search access while Bing works fine - trying Bing first means most
# searches succeed immediately instead of waiting through several timeouts first. If a run
# feels much slower than usual, this is the first thing to check.
DDGS_BACKENDS=bing,duckduckgo,brave,mojeek
WEB_FETCH_ENABLED=true
SELENIUM_HEADLESS=true
WIKIDATA_ENABLED=true
MARKET_QUERY_OUTPUT_DIR=output/demo
CSV_OUTPUT_DIR=output

# Optional: install Google Chrome for better company-site scraping
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
