# =============================================================================
# Vendor Intelligence — copy to .env (never commit .env)
# =============================================================================
# LIVE runs (run_query.py / run_pipeline.py): set USE_MOCK_DATA=false and one LLM key.
USE_MOCK_DATA=false

# Pick ONE provider:
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=PASTE_YOUR_KEY_HERE
# Faster/cheaper than Sonnet for 130-company classify runs:
COMPILER_MODEL=claude-haiku-4-5-20251001
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# Phase 1 market understanding only (large value-chain JSON) — use Sonnet
MARKET_MAP_MODEL=claude-sonnet-4-6
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=PASTE_YOUR_KEY_HERE
# OPENCODE_MODEL=deepseek-v4-flash-free
# When LLM_PROVIDER=anthropic but quota is hit, fall back to OpenCode if key is set:
# LLM_FALLBACK_TO_OPENCODE=true

PIPELINE_PROFILE=quality

# Higher volume (global) — defaults: discover/enrich 280, export 240 rows
# Japan/regional — defaults: discover/enrich 250, export 200 rows
# PIPELINE_GLOBAL_DISCOVER_MAX=280
# PIPELINE_GLOBAL_ENRICH_MAX=280
# PIPELINE_GLOBAL_EXPORT_MAX_ROWS=240
# PIPELINE_DISCOVER_MAX=250
# PIPELINE_EXPORT_MAX_ROWS=200
# TARGET_UNIQUE_COMPANIES=280
# DISCOVERY_YIELD_MIN_UNIQUE=200

SKIP_DDGS=false
SKIP_BING_HTML=false
RESULTS_PER_QUERY=25
# Phase 2 discovery: parallel prompt searches (requires DDG_WORKER_COUNT>0)
# DISCOVERY_PARALLEL_BATCH=4
WIKIDATA_ENABLED=true
WEB_FETCH_ENABLED=true

# --- MOCK demo only (empty results) ---
# USE_MOCK_DATA=true

# -----------------------------------------------------------------------------
# LIVE MODE — copy env.live.template into .env and fill PASTE_* values
# -----------------------------------------------------------------------------
# USE_MOCK_DATA=false
# LLM_PROVIDER=opencode
# OPENCODE_API_KEY=paste-from-https://opencode.ai/zen
# OPENCODE_MODEL=nemotron-3-super-free
# Same OPENCODE_API_KEY works for all Zen free models (no new key to switch model).
# deepseek-v4-flash-free often rejects response_format — prefer nemotron or big-pickle.
# SMART_CRAWL_USE_JSON_SCHEMA=false
# SMART_CRAWL_USE_JSON_SCHEMA=false
# Optional: real OpenAI for crawls only (better extraction):
# OPENAI_API_KEY=paste-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Or: LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY=paste-from-console.anthropic.com
MAX_LLM_CALLS_PER_RUN=1

# Quality pipeline (~20 min, 25-65 vetted rows) — default:
# PIPELINE_PROFILE=quality
# PIPELINE_USE_SSC=true
# PIPELINE_DISCOVER_MAX=70
# PIPELINE_ENRICH_MAX=50
# PIPELINE_MIN_EXPORT_CONFIDENCE=0.45
#
# Higher volume when run_pipeline.py --country global (auto, no --recall):
# PIPELINE_GLOBAL_DISCOVER_MAX=110
# PIPELINE_GLOBAL_ENRICH_MAX=80
# PIPELINE_GLOBAL_EXPORT_MIN_ROWS=50
# PIPELINE_GLOBAL_EXPORT_MAX_ROWS=95
# PHASE1_GLOBAL_SMOKE_MAX_PROMPTS=10
# PHASE1_GLOBAL_DISCOVERY_PROMPTS=20
# PIPELINE_GLOBAL_VOLUME_PROMPT_COUNT=36
#
# Broad / noisy export:
# PIPELINE_RECALL_MODE=true
# Or: run_pipeline.py --recall
#
# Slower deep crawl (not SSC):
# run_pipeline.py --full-crawl

# -----------------------------------------------------------------------------
# Free search — DDGS → Bing HTML → SearXNG (no paid API keys)
# -----------------------------------------------------------------------------
SEARCH_PRIMARY=duckduckgo
SEARCH_BACKUP=searxng
SKIP_DDGS=false
SKIP_BING_HTML=false
PREFER_SEARXNG=false
# deedy5/ddgs text() backends — no startpage/auto (WinError 10061 on some networks)
# https://github.com/deedy5/ddgs#engines
# Bing first: some networks (corporate firewalls, certain ISPs) time out/refuse DuckDuckGo,
# Google, and Mojeek while Bing works fine — trying it first avoids paying for several
# timeouts on every single search before reaching a backend that actually works.
DDGS_BACKENDS=bing,duckduckgo,brave,mojeek
# Proxy pipeline (run once):  python scripts/check_proxies.py
# USE_PROXY_POOL=true
# DDGS_USE_PROXY_POOL=true
# DDGS_ALLOW_DIRECT=false
# DDGS_AUTO_PROXY=false
# PROXY_POOL_CACHE=output/proxy_pool_verified.json
# PROXY_MAX_CHECK=40
# Optional: DDGS_PROXY=  DDGS_VERIFY=true  DDGS_NEWS_BACKENDS=bing,duckduckgo,yahoo
SEARCH_USE_FALLBACKS=true
SEARXNG_BASE_URL=http://127.0.0.1:8080
MIN_RESULTS_BEFORE_BACKUP=3
RESULTS_PER_QUERY=25

# -----------------------------------------------------------------------------
# Google Alerts — backend article collector (no Google API)
# Best: paste RSS URLs from https://www.google.com/alerts (RSS icon per alert)
# Optional: Selenium + Chrome profile for auto-discovering RSS feeds
# -----------------------------------------------------------------------------
GOOGLE_ALERTS_ENABLED=false
# Comma-separated RSS feed URLs (recommended — works without browser)
# GOOGLE_ALERTS_RSS_URLS=https://www.google.com/alerts/feeds/xxxxx/yyyyy
GOOGLE_ALERTS_PROFILE_PATH=data/chrome-profile
GOOGLE_ALERTS_HEADLESS=false
GOOGLE_ALERTS_STORE_PATH=data/alerts/articles.json

# -----------------------------------------------------------------------------
# Optional RSS (comma-separated URLs)
# -----------------------------------------------------------------------------
# RSS_FEED_URLS=

# -----------------------------------------------------------------------------
# Enrichment — free
# -----------------------------------------------------------------------------
WIKIDATA_ENABLED=true
WEB_FETCH_ENABLED=true

# Company website scraping — ddgs.extract() (https://pypi.org/project/ddgs/)
SCRAPE_BACKEND=ddgs
SCRAPE_EXTRACT_FMT=text_markdown
SELENIUM_HEADLESS=true
SELENIUM_PAGE_LOAD_TIMEOUT=25
SELENIUM_IMPLICIT_WAIT=3
SELENIUM_SCROLL_PAUSE=0.6
# CHROME_BINARY_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# -----------------------------------------------------------------------------
# CSV output
# -----------------------------------------------------------------------------
CSV_OUTPUT_ENABLED=true
CSV_OUTPUT_DIR=output
# Demo / CEO CSV exports from run_query.py (default: output/demo)
MARKET_QUERY_OUTPUT_DIR=output/demo

# -----------------------------------------------------------------------------
# Tuning — discovery & output volume
# -----------------------------------------------------------------------------
RESULTS_PER_QUERY=25
MAX_VALIDATION_ENTITIES=60
TARGET_SOLID_COMPANIES=30

# -----------------------------------------------------------------------------
# Phase 3 — fast validation (default: on)
# -----------------------------------------------------------------------------
PHASE3_FAST_VALIDATION=true
PHASE3_PARALLEL_WORKERS=3
PHASE3_MAX_HITS_PER_QUERY=3
# DDG news.js often rate-limits — leave false
DDG_NEWS_API=false

# -----------------------------------------------------------------------------
# Paid APIs — NOT used in free-first plan (leave commented)
# -----------------------------------------------------------------------------
# SERPAPI_API_KEY=
# (Brave/Serper paid APIs removed — use DDGS + Bing HTML + SearXNG)
# TAVILY_API_KEY=
# NEWSAPI_API_KEY=
# GNEWS_API_KEY=
# CLEARBIT_API_KEY=
# FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Auth — email OTP + JWT (24h) + Postgres
# -----------------------------------------------------------------------------
# Start DB:  docker compose up -d postgres
# Init:      .venv\Scripts\python.exe scripts\init_auth_db.py
DATABASE_URL=postgresql+psycopg://vendor:vendor@127.0.0.1:5432/vendor_intel
# Long random secret for signing JWTs (required in production)
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
AUTH_SESSION_HOURS=24
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_SECONDS=60
AUTH_OTP_MAX_PER_WINDOW=3
AUTH_OTP_WINDOW_MINUTES=15
# Only company emails can sign in (username@coherentmarketinsights.com)
AUTH_ALLOWED_EMAIL_DOMAINS=coherentmarketinsights.com
# console = print OTP in the terminal (local demo). Production: smtp or resend
AUTH_EMAIL_BACKEND=console
AUTH_APP_NAME=Vendor Intelligence
# Temporary: true = skip email OTP codes (email + allowed domain only). Set false for real OTP.
AUTH_SKIP_OTP=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@coherentmarketinsights.com
# SMTP_USE_TLS=true
# RESEND_API_KEY=
# AUTH_API_PORT=8001
# Comma-separated emails promoted to role=admin on next OTP login (optional)
# AUTH_ADMIN_EMAILS=you@coherentmarketinsights.com
